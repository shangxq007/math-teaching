# hv-guide / hv-bank 由 build_all.py 生成的版本包装文件与中间产物
_variant_*.tex
hvguide_*.pdf
hv-guide/dist/
hv-bank/dist/

# Manim 渲染产物（视频 / 媒体，不入库；重新渲染即可复现）
*.mp4
*.webm
*.gif
math/manim/**/media/
math/manim/**/videos/

# 版式打样的编译输出（png 截图保留作对照）
_preview/*.pdf

# 编译输出（保留 figures 下的矢量图）
*.pdf
!**/figures/*.pdf
!**/figures/**/*.pdf

# 编辑器（保留工作区配置，便于换机器复用）
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
*.swp
*~
.DS_Store
