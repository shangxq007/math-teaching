digraph three_quadratics {
  rankdir = TB;
  fontname = "Noto Sans CJK SC";
  nodesep = 0.35;
  ranksep = 0.55;
  node [fontname="Noto Sans CJK SC", fontsize=15, shape=box,
        style="rounded,filled", margin="0.18,0.11"];
  edge [fontname="Noto Sans CJK SC", fontsize=12, color="#B0BEC5",
        fontcolor="#78909C", arrowsize=1.0, penwidth=1.3];

  f [label="二次函数\ny = ax² + bx + c", fillcolor="#ECEFF1", color="#546E7A"];
  zero [label="令 y = 0", fillcolor="#E3F2FD", color="#1565C0"];
  pos [label="令 y > 0", fillcolor="#E3F2FD", color="#1565C0"];
  neg [label="令 y < 0", fillcolor="#E3F2FD", color="#1565C0"];

  eq [label="一元二次方程\nax² + bx + c = 0", fillcolor="#E8F5E9", color="#2E7D32"];
  ineq1 [label="一元二次不等式\nax² + bx + c > 0", fillcolor="#FFF3E0", color="#EF6C00"];
  ineq2 [label="一元二次不等式\nax² + bx + c < 0", fillcolor="#FFF3E0", color="#EF6C00"];

  root [label="根 x₁、x₂\n（图象与 x 轴交点）", fillcolor="#E8F5E9", color="#2E7D32"];
  up [label="解集：两根之外\n（图象在 x 轴上方）", fillcolor="#FFF3E0", color="#EF6C00"];
  down [label="解集：两根之间\n（图象在 x 轴下方）", fillcolor="#FFF3E0", color="#EF6C00"];

  note [label="图中结论成立的条件：\na > 0 且 Δ > 0", shape=note, fillcolor="#FFFDE7", color="#F9A825", fontsize=13];

  f -> zero;
  f -> pos;
  f -> neg;
  zero -> eq;
  pos -> ineq1;
  neg -> ineq2;
  eq -> root;
  ineq1 -> up;
  ineq2 -> down;
  root -> up [style=dashed, label="边界"];
  root -> down [style=dashed, label="边界"];
  note -> up [style=invis];
}
