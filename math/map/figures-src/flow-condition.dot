digraph flow_condition {
  rankdir = TB;
  fontname = "Noto Sans CJK SC";
  node [fontname="Noto Sans CJK SC", fontsize=11, shape=box,
        style="rounded,filled", margin="0.14,0.09"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#757575",
        fontcolor="#616161", arrowsize=0.8];

  start [label="开始", shape=ellipse, fillcolor="#FFF9C4", color="#F9A825"];
  pa [label="把条件 p 化为集合 A\n（解不等式 / 方程）", fillcolor="#E3F2FD", color="#1565C0"];
  qb [label="把条件 q 化为集合 B\n（解不等式 / 方程）", fillcolor="#E3F2FD", color="#1565C0"];
  cmp [label="比较 A 与 B\n的包含关系", shape=diamond, fillcolor="#FFF3E0", color="#EF6C00"];
  eq [label="A = B", shape=diamond, fillcolor="#FFF3E0", color="#EF6C00"];
  sub [label="A ⊊ B", shape=diamond, fillcolor="#FFF3E0", color="#EF6C00"];
  sup [label="B ⊊ A", shape=diamond, fillcolor="#FFF3E0", color="#EF6C00"];
  r1 [label="p 是 q 的\n充要条件", fillcolor="#E8F5E9", color="#2E7D32"];
  r2 [label="p 是 q 的\n充分不必要条件", fillcolor="#E8F5E9", color="#2E7D32"];
  r3 [label="p 是 q 的\n必要不充分条件", fillcolor="#E8F5E9", color="#2E7D32"];
  r4 [label="p 是 q 的\n既不充分也不必要条件", fillcolor="#FFEBEE", color="#C62828"];
  end [label="结论", shape=ellipse, fillcolor="#FFF9C4", color="#F9A825"];

  start -> pa -> qb -> cmp;
  cmp -> eq [label="A = B"];
  cmp -> sub [label="A ⊊ B"];
  cmp -> sup [label="B ⊊ A"];
  cmp -> r4 [label="互不包含"];
  eq -> r1;
  sub -> r2;
  sup -> r3;
  r1 -> end;
  r2 -> end;
  r3 -> end;
  r4 -> end;
}
